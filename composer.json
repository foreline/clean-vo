{
    "name": "foreline/clean-vo",
    "description": "Domain Value Objects for the foreline/clean clean-architecture framework (Money, IPv4, NetworkIdentifier, FilePath, …) plus shipped foreline/crud UI configuration",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "value-object",
        "domain",
        "clean-architecture",
        "money",
        "ipv4",
        "email",
        "domain-name",
        "url"
    ],
    "authors": [
        {
            "name": "Simakin Dima",
            "email": "dima@foreline.ru"
        }
    ],
    "require": {
        "php": ">=8.1",
        "foreline/clean": ">=1.0 <3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "*"
    },
    "autoload": {
        "psr-4": {
            "Domain\\ValueObject\\": "src/ValueObject"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "foreline-crud": {
            "vo-config-paths": [
                "config/crud/vo"
            ]
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "git",
            "url": "git@github.com:foreline/clean.git"
        }
    ]
}
