{
    "valueObject": {
        "class": "Domain\\ValueObject\\IPv4\\IPv4",
        "ui": {
            "parts": {
                "address": {
                    "type": "text",
                    "cssClasses": ["ipv4-input"],
                    "attributes": {
                        "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$",
                        "inputmode": "numeric",
                        "maxlength": "15",
                        "autocomplete": "off"
                    },
                    "placeholder": "0.0.0.0"
                }
            }
        }
    }
}
